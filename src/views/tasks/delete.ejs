<h2>Delete task</h2>

<p>Are you sure you want to delete this task?</p>

<table border="1" cellpadding="6">
  <tr>
    <th>Task id</th>
    <td><%= task.id %></td>
  </tr>
  <tr>
    <th>Title</th>
    <td><%= task.title %></td>
  </tr>
  <tr>
    <th>Completed</th>
    <td><%= task.completed ? 'Yes' : 'No' %></td>
  </tr>
</table>

<form method="post">
  <p>
    <button type="submit">Delete task</button>
  </p>
</form>

<p><a href="/crud/tasks/<%= task.id %>">Cancel</a></p>